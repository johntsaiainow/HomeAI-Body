# Default-deny: only explicitly reviewed source/config/docs enter this repository.
/*
!/.gitignore
!/README.md
!/system.py
!/llm_service.py
!/model_router.py
!/model_lifecycle.py
!/install-comfyui.sh
!/start-comfyui.sh
!/download-t5.sh
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.sh
!/docs/
/docs/*
!/docs/*.md
!/config/
/config/*
!/config/examples/
/config/examples/*
!/config/examples/*.json
!/config/assets-manifest.json
!/body/
/body/*
!/body/*.py
!/body/*.sh
!/body/requirements.txt
!/body/actions.json
!/body/lyrics-artist-aliases.json
!/body/lyrics-title-aliases.json
!/voice/
/voice/*
!/voice/*.py
!/voice/*.sh
!/asr/
/asr/*
!/asr/*.py
!/tts-taigi/
/tts-taigi/*
!/tts-taigi/*.py
!/tts-taigi/*.sh
!/tts-taigi/requirements-local.txt
!/generation/
/generation/*
!/generation/*.py
# Keep personal/runtime documentation, settings and artifacts out even if added later.
**/__pycache__/
**/.venv/
**/*.pyc
**/*.log
**/*.sock
**/.env*
**/*secret*
**/*key.txt

# Public project metadata and CI.
!/homeai_config.py
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml

# Original, redistributable placeholder media only.
!/demo/
/demo/*
!/demo/README.md
!/demo/robot.png
!/demo/robot.webp
!/demo/robot.mp4
!/config/demo-assets-manifest.json

# Screenshots explicitly supplied for the public README.
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/idle.png
!/docs/screenshots/dancing.png
!/docs/screenshots/vulcan-salute.png
